{
  "name": "@opendb-dsh/directory-picker-agent",
  "version": "0.0.1",
  "description": "dsh directoryPicker provider that turns 'pick a directory' into 'pick an agent' (workspace == agent) — browse capability served to dsh's stock browse UI unchanged",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker": "^0.1.0-rc.6"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1", "@opendb-dsh/registry": "workspace:*" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker": "^0.1.0-rc.6"
  }
}
