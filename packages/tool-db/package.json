{
  "name": "@opendb-dsh/tool-db",
  "version": "0.0.1",
  "description": "Read-only database diagnostics tools (db_nodes / db_query / db_overview) for opendb-dsh Runtime pods — scoped to the nodes bound to the session's platform agent",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/dsh-tools": "^0.1.0-rc.6" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opendb-dsh/db": "workspace:*",
    "@opendb-dsh/registry": "workspace:*",
    "pgsql-ast-parser": "^12.0.2"
  },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/dsh-tools": "^0.1.0-rc.6" }
}
