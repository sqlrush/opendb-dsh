{
  "name": "@opendb-dsh/scheduler",
  "version": "0.0.1",
  "description": "Cron schedules for opendb-dsh agents: at fire time a fresh session is created in the agent's workspace and the prompt is queued (Host-side plugin, CAS-idempotent)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opendb-dsh/session-persistence-pg": "workspace:*",
    "@opendb-dsh/registry": "workspace:*"
  },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@types/pg": "^8.11.10" }
}
