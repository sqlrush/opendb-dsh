{
  "name": "@opendb-dsh/registry",
  "version": "0.0.1",
  "description": "opendb-dsh platform registry: tenants / users / agents / db nodes / groups on PostgreSQL (ctx.registry), with agent<->dsh-workspace binding",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opendb-dsh/session-persistence-pg": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.1" }
}
