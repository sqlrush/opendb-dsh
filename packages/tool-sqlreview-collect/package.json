{
  "name": "@opendb-dsh/tool-sqlreview-collect",
  "version": "0.0.1",
  "description": "sqlreview_collect tool: deterministic SQL review rules + plan-anchored slow-SQL scan for Runtime pods (task-sqlreview's collector half)",
