  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opendb-dsh/session-persistence-pg": "workspace:*",
    "@opendb-dsh/task-sqlreview": "workspace:*",
    "@opendb-dsh/tool-db": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@deepseek-ai/dsh-tools": "^0.1.0-rc.6" }
