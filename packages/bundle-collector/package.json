{
  "name": "@opendb-dsh/bundle-collector",
  "version": "0.0.1",
  "description": "opendb-dsh Collector bundle: patch layer over dsh-base (no agent loop; db seam scrapes into metrics/dictionary storage)",
  "type": "module",
  "files": ["cordis.patch.yml"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@opendb-dsh/session-persistence-pg": "workspace:*",
    "@opendb-dsh/tenant-context": "workspace:*",
    "@opendb-dsh/registry": "workspace:*",
    "@opendb-dsh/db": "workspace:*",
    "@opendb-dsh/db-opengauss": "workspace:*",
    "@opendb-dsh/metrics-timescale": "workspace:*",
    "@opendb-dsh/dictionary-pg": "workspace:*",
    "@opendb-dsh/collector": "workspace:*"
  }
}
