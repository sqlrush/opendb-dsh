{
  "name": "@opendb-dsh/db",
  "version": "0.0.1",
  "description": "opendb-dsh db seam: per-node read-only pools to managed database nodes + engine dialect registry (PostgreSQL baseline built in; db-opengauss provides the openGauss dialect)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib"],
  "scripts": { "build": "tsc -p tsconfig.json", "test": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts" },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.1" },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opendb-dsh/registry": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": { "@deepseek-ai/cordis": "^4.0.1", "@types/pg": "^8.11.10" }
}
